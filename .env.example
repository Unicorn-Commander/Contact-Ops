# Contact-Ops - Environment Configuration
# Copy this file to .env and configure for your environment.
# Real secrets MUST NOT live in this template; substitute placeholders.

# =============================================================================
# Database Configuration
# =============================================================================
# Prod uses a dedicated container (contact-ops-postgres). Replace <password>.
# Authenticate as contact_ops_runtime: the app LOGIN role (NOBYPASSRLS, so it
# is RLS-subject), which the deploy bootstrap creates as a member of the NOLOGIN
# policy role contact_ops_app. The RLS policies and table grants target
# contact_ops_app, so the runtime role inherits them and the policies apply.
# Do NOT point this at a superuser or a role outside contact_ops_app: it would
# either lack every grant/policy or silently BYPASS RLS. The real deploy
# templates (deploy/cell/.env.cell.template, deploy/selfcontained/.env.selfcontained.template)
# are the source of truth for the role split (runtime vs admin vs audit).
DATABASE_URL=postgresql+asyncpg://contact_ops_runtime:<password>@contact-ops-postgres:5432/contact_ops_db

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_URL=redis://unicorn-redis:6379/5

# =============================================================================
# SMTP Verification Settings
# =============================================================================
SMTP_TIMEOUT=10
SMTP_CONCURRENCY=10

# =============================================================================
# Authentication Configuration
# =============================================================================
# Set true only for local dev (bypasses JWT validation). Always false in prod.
STANDALONE_MODE=false

# =============================================================================
# Keycloak OIDC Configuration
# =============================================================================
# Prod issuer for the production deploy. The SPA validates tokens against
# this issuer directly (no OAuth2 Proxy).
KEYCLOAK_URL=https://auth.magicunicorn.dev
KEYCLOAK_REALM=uchub
KEYCLOAK_AUDIENCE=contact-ops-mcp

# =============================================================================
# LLM (for the AI Contacts Analyst chat orchestrator)
# =============================================================================
# Points at the in-cluster LiteLLM router. Replace <key>.
LLM_BASE_URL=http://unicorn-litellm:4000/v1
LLM_API_KEY=<litellm-key>

# =============================================================================
# Contact Import Connectors
# =============================================================================
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTOR_ENCRYPTION_KEY=<fernet-key>

M365_CLIENT_ID=<azure-ad-app-client-id>
M365_CLIENT_SECRET=<azure-ad-app-client-secret>
M365_REDIRECT_URI=https://mcp.contacts.magicunicorn.dev/api/connectors/m365/oauth/callback

GMAIL_CLIENT_ID=<google-cloud-oauth-client-id>
GMAIL_CLIENT_SECRET=<google-cloud-oauth-client-secret>
GMAIL_REDIRECT_URI=https://mcp.contacts.magicunicorn.dev/api/connectors/gmail/oauth/callback
FRONTEND_URL=https://contacts.magicunicorn.dev

# =============================================================================
# Logging
# =============================================================================
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# =============================================================================
# Ops Center Integration (optional)
# =============================================================================
OPS_CENTER_URL=
OPS_CENTER_API_KEY=

# =============================================================================
# API Configuration (optional)
# =============================================================================
# API_KEY_HEADER=X-API-Key
# RATE_LIMIT_REQUESTS=100
# RATE_LIMIT_WINDOW=60

# =============================================================================
# Security Settings (optional)
# =============================================================================
# CORS_ORIGINS=https://contacts.magicunicorn.dev
# ALLOWED_HOSTS=contacts.magicunicorn.dev,mcp.contacts.magicunicorn.dev,carddav.contacts.magicunicorn.dev

# =============================================================================
# Brigade Ecosystem Registry
# =============================================================================
BRIGADE_REGISTRY_URL=https://brigade.magicunicorn.dev/api/registry/services
BRIGADE_SERVICE_TOKEN=
