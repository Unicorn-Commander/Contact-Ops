# Build stage
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY . .

ARG VITE_MCP_BASE_URL=https://mcp.contacts.magicunicorn.dev
ARG VITE_KEYCLOAK_ISSUER=https://auth.magicunicorn.dev/realms/uchub
ARG VITE_KEYCLOAK_CLIENT_ID=contact-ops-app
ENV VITE_MCP_BASE_URL=$VITE_MCP_BASE_URL
ENV VITE_KEYCLOAK_ISSUER=$VITE_KEYCLOAK_ISSUER
ENV VITE_KEYCLOAK_CLIENT_ID=$VITE_KEYCLOAK_CLIENT_ID

# Free-tier on-device AI (WebGPU + transformers.js). OFF by default; the public
# build passes true so the free tier's local analyst is compiled in.
ARG VITE_ENABLE_LOCAL_AI=false
ENV VITE_ENABLE_LOCAL_AI=$VITE_ENABLE_LOCAL_AI
# Optional explicit REST API base; when empty the SPA derives it from VITE_MCP_BASE_URL.
ARG VITE_API_BASE=
ENV VITE_API_BASE=$VITE_API_BASE

# Build the application
RUN npm run build

# Production stage
FROM nginx:alpine AS production

# Copy custom nginx config
COPY --from=builder /app/nginx.conf /etc/nginx/conf.d/default.conf

# Copy built assets from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Add healthcheck
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:80/nginx-health || exit 1

# Expose port
EXPOSE 80

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
