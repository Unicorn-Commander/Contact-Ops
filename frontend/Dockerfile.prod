# Build stage
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY . .

ARG VITE_MCP_BASE_URL=https://mcp.contacts.magicunicorn.dev
ARG VITE_KEYCLOAK_ISSUER=https://auth.magicunicorn.dev/realms/uchub
ARG VITE_KEYCLOAK_CLIENT_ID=contact-ops-app
ENV VITE_MCP_BASE_URL=$VITE_MCP_BASE_URL
ENV VITE_KEYCLOAK_ISSUER=$VITE_KEYCLOAK_ISSUER
ENV VITE_KEYCLOAK_CLIENT_ID=$VITE_KEYCLOAK_CLIENT_ID
# Cross-app suite deep-links. Empty default = SAFE (the Project-Ops link degrades
# to plain text); UC cells set this (dogfood -> projects.magicunicorn.dev, prod ->
# projects.unicorncommander.ai). A self-host cell leaves it empty unless it runs
# Project-Ops on a known domain.
ARG VITE_PROJECTS_BASE_URL=
ENV VITE_PROJECTS_BASE_URL=$VITE_PROJECTS_BASE_URL
# Analytics (Umami + PostHog) — empty defaults so the bundle is byte-identical
# until these are set; the SPA loaders stay dormant on empty values.
ARG VITE_UMAMI_SRC=
ARG VITE_UMAMI_WEBSITE_ID=
ARG VITE_POSTHOG_KEY=
ARG VITE_POSTHOG_HOST=
ENV VITE_UMAMI_SRC=$VITE_UMAMI_SRC
ENV VITE_UMAMI_WEBSITE_ID=$VITE_UMAMI_WEBSITE_ID
ENV VITE_POSTHOG_KEY=$VITE_POSTHOG_KEY
ENV VITE_POSTHOG_HOST=$VITE_POSTHOG_HOST

# Build the application
RUN npm run build

# Production stage
FROM nginx:alpine AS production

# Copy custom nginx config
COPY --from=builder /app/nginx.conf /etc/nginx/conf.d/default.conf

# Copy built assets from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Add healthcheck
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:80/nginx-health || exit 1

# Expose port
EXPOSE 80

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
