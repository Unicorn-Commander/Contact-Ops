# Contact-Ops frontend environment.
# Copy to `.env.local` and adjust. All client-exposed vars MUST be prefixed VITE_.

# --- API + auth (see src/lib/env.ts) ---
# Base URL for the MCP API.
VITE_MCP_BASE_URL=https://mcp.contacts.magicunicorn.dev
# Keycloak OIDC issuer (uchub realm).
VITE_KEYCLOAK_ISSUER=https://auth.magicunicorn.dev/realms/uchub
# OIDC client id registered on Keycloak.
VITE_KEYCLOAK_CLIENT_ID=contact-ops-app
# Optional deep-link handoff URL for the desktop app.
# VITE_DESKTOP_HANDOFF_URL=

# --- FREE-tier on-device AI foundation ---
# Gates the WebGPU LLM + embeddings + local IndexedDB contact store
# (src/lib/ondevice/*). When "false" (default) none of it loads, downloads,
# or registers — the heavyweight @huggingface/transformers runtime stays inert.
# Set to "true" to opt in. Requires a WebGPU-capable browser at runtime.
VITE_ENABLE_LOCAL_AI=false
