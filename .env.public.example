# Contact-Ops PUBLIC instance (centerdeep) — env template.
# Copy to .env on the host and fill the <generate> values. The real .env is NOT
# committed. Generate secrets with: openssl rand -hex 24   (passwords/keys),
# python -c "import secrets;print(secrets.token_urlsafe(32))" (Fernet/connector key).

# ---- domains (also drive Traefik Host() rules via compose substitution) ----
APP_DOMAIN=contacts.unicorncommander.ai
MCP_DOMAIN=mcp.contacts.unicorncommander.ai
CARDDAV_DOMAIN=carddav.contacts.unicorncommander.ai

# ---- app meta ----
ENV=prod
DEBUG=false
LOG_LEVEL=INFO
APP_NAME=Contact-Ops
APP_VERSION=public-1.0

# ---- dedicated Postgres (pgvector) ----
# Superuser password (migrations + role bootstrap); runtime + audit are non-superuser.
PG_SUPER_PASSWORD=<generate>
CO_APP_PASSWORD=<generate>
CO_AUDIT_PASSWORD=<generate>
DATABASE_URL=postgresql+asyncpg://co_app:<CO_APP_PASSWORD>@contact-ops-postgres:5432/contactops
AUDIT_DATABASE_URL=postgresql+asyncpg://co_audit:<CO_AUDIT_PASSWORD>@contact-ops-postgres:5432/contactops
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:<PG_SUPER_PASSWORD>@contact-ops-postgres:5432/contactops
TENANT_GUC_NAME=app.tenant_id

# ---- Redis / FalkorDB / Qdrant (dedicated) ----
REDIS_URL=redis://contact-ops-redis:6379/0
FALKORDB_URL=redis://contact-ops-falkordb:6379
FALKORDB_GRAPH_MODE=database
FALKORDB_GRAPH_PREFIX=contact_ops
QDRANT_URL=http://contact-ops-qdrant:6333
QDRANT_API_KEY=<generate>

# ---- Garage (object storage; dedicated) ----
GARAGE_RPC_SECRET=<generate-hex-32>
GARAGE_ADMIN_TOKEN=<generate>
GARAGE_ENDPOINT=http://contact-ops-garage:3900
GARAGE_ADMIN_ENDPOINT=http://contact-ops-garage:3903
GARAGE_ACCESS_KEY=<from `garage key create` after first boot>
GARAGE_SECRET_KEY=<from `garage key create` after first boot>

# ---- Keycloak (canonical PUBLIC SSO — auth.unicorncommander.ai, uchub realm) ----
KEYCLOAK_ISSUER=https://auth.unicorncommander.ai/realms/uchub
KEYCLOAK_JWKS_URL=https://auth.unicorncommander.ai/realms/uchub/protocol/openid-connect/certs
KEYCLOAK_CLIENT_ID=contact-ops-app
KEYCLOAK_AUDIENCE=contact-ops-mcp
JWT_ALLOWED_ALGORITHMS=RS256
TRUSTED_MCP_CLIENTS=contact-ops-app,contact-ops-switch,contact-ops-mcp
# Service account that writes tenant_id/tenant_slug for auto-provision + switch.
KEYCLOAK_SWITCH_CLIENT_ID=contact-ops-switch
KEYCLOAK_SWITCH_CLIENT_SECRET=<from kcadm after creating contact-ops-switch>

# ---- web / CORS ----
STANDALONE_MODE=false
FRONTEND_URL=https://contacts.unicorncommander.ai
CORS_ORIGINS=https://contacts.unicorncommander.ai
CORS_ALLOW_CREDENTIALS=true

# ---- secrets ----
# Fernet key for connector credential encryption (required when STANDALONE_MODE=false).
CONNECTOR_ENCRYPTION_KEY=<generate>

# ---- enforcement flags: ALL OFF for the standalone-SSO launch ----
TENANT_CLAIM_AZP_ENFORCE=false
MEMBERSHIP_GATE_ENFORCED=false
WORKSPACE_PER_REQUEST_ENABLED=false
BILLING_TIER_ENFORCED=false
RLS_SELFTEST_TENANT_IDS=

# ---- DARK at launch (leave unset until lit up) ----
# Pro server analyst → point at the gateway when enabling Pro:
#   LLM_BASE_URL=http://<gateway>/v1   LLM_API_KEY=<co gateway key>   LLM_MODEL=...
# Connectors (M365_*, GMAIL_*) → use brokered IdP tokens later, NOT per-app OAuth.
# DATA_INTEL_* → optional enrichment integration.
# BRIDGE_INBOUND_CLIENT_SECRET / CARDDAV_CLIENT_SECRET → set when those are enabled.
