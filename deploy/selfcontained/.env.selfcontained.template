# Contact-Ops local/self-hosted compose contract.
#
# The README quickstart copies this file to .env and fills every blank secret
# with a fresh value. Do not commit the resulting .env. The local stack uses
# loopback URLs only; change the APP_ORIGIN/MCP_ORIGIN/Keycloak hostname as one
# coordinated deployment change if you later put a reverse proxy in front.

# Compose/application identity
APP_NAME=Contact-Ops
APP_VERSION=2.19.0
ENV=prod
DEBUG=false
LOG_LEVEL=INFO
DEPLOYMENT_MODE=self_host
STANDALONE_MODE=false
APP_ORIGIN=http://127.0.0.1:3000
MCP_ORIGIN=http://127.0.0.1:8501
FRONTEND_URL=http://127.0.0.1:3000

# Legacy self-contained compose labels. The stranger compose does not use
# Traefik or these host rules, but keeping the names in the shared template
# prevents the existing self-contained compose from receiving empty labels.
APP_DOMAIN=127.0.0.1
MCP_DOMAIN=127.0.0.1
CARDDAV_DOMAIN=127.0.0.1
CERT_RESOLVER=

# Bundled Postgres. The first value is used by the database container; the
# runtime value is used by the RLS-subject application role.
PG_ADMIN_PASSWORD=
CO_RUNTIME_PASSWORD=
DATABASE_URL=postgresql+asyncpg://contact_ops_runtime:@contact-ops-postgres:5432/contact_ops_db
AUDIT_DATABASE_URL=postgresql+asyncpg://contact_ops_runtime:@contact-ops-postgres:5432/contact_ops_db
MIGRATION_DATABASE_URL=${CONTACT_OPS_DATABASE_URL}

# The db-bootstrap service runs `python -m contact_ops.ops.seed_rls_probes`
# before the API starts. A fresh database gets slugs rls-probe-a / rls-probe-b
# (strict, one placeholder person each) at the ids below. Leave this line as
# shipped: prestart will not migrate an existing database when the runtime role
# is non-privileged and these two tenants are missing. Re-running the command
# prints the same line and does not change the rows.
SEED_OWNER_USER_ID=00000000-0000-0000-0000-000000000001
RLS_SELFTEST_TENANT_IDS=11111111-1111-4111-8111-111111111111,22222222-2222-4222-8222-222222222222
TENANT_GUC_NAME=app.tenant_id
UC_UID_GUC_NAME=app.uc_uid

# Bundled data services
REDIS_URL=redis://contact-ops-redis:6379/5
QDRANT_URL=http://contact-ops-qdrant:6333
QDRANT_API_KEY=
FALKORDB_URL=redis://contact-ops-falkordb:6379
FALKORDB_GRAPH_MODE=per_org_graph
FALKORDB_GRAPH_PREFIX=contact_ops__
GARAGE_ENDPOINT=http://contact-ops-garage:3900
GARAGE_ADMIN_ENDPOINT=http://contact-ops-garage:3903
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
GARAGE_ACCESS_KEY=
GARAGE_SECRET_KEY=
GARAGE_AUTO_PROVISION=false
GARAGE_PROVISION_MODE=shared_key

# Required application encryption key. Generate a Fernet key in the README
# quickstart; this is not a password and is never supplied as a fixed value.
CONNECTOR_ENCRYPTION_KEY=
CONNECTOR_ENCRYPTION_KEYS=

# Bundled Keycloak. The public issuer is deliberately a loopback-resolving
# hostname so JWT iss validation, browser OIDC, and backend admin calls agree.
KEYCLOAK_REALM=contact-ops
KEYCLOAK_ISSUER=http://contact-ops.localhost:8080/realms/contact-ops
KEYCLOAK_JWKS_URL=
KEYCLOAK_CLIENT_ID=contact-ops-mcp
KEYCLOAK_AUDIENCE=contact-ops-mcp
KEYCLOAK_SWITCH_CLIENT_ID=contact-ops-switch
KEYCLOAK_SWITCH_CLIENT_SECRET=
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=
KC_ADMIN_USER=admin
KC_ADMIN_PASS=
SIGNUP_ENABLED=false
SIGNUP_MODE=standalone
SUITE_SIGNUP_URL=

# JWT / browser contract
JWT_ALLOWED_ALGORITHMS=["RS256"]
TENANT_CLAIM_ALLOWED_AZP=["contact-ops-app","contact-ops-switch","contact-ops-mcp"]
TENANT_CLAIM_AZP_ENFORCE=false
MEMBERSHIP_GATE_ENFORCED=false
CORS_ORIGINS=["http://127.0.0.1:3000"]
CORS_ALLOW_CREDENTIALS=true
METRICS_HTTP_ENABLED=true

# No external integrations are enabled by this quickstart.
BRIGADE_REGISTRY_URL=
BRIGADE_SERVICE_TOKEN=
BRIGADE_TRUSTED_ISSUER=
BRIGADE_TRUSTED_ISSUERS=
BRIGADE_JWKS_URL=
BRIGADE_EXPECTED_AUDIENCE=contact-ops
DATA_INTEL_BASE_URL=
DATA_INTEL_CLIENT_ID=contact-ops-publisher
DATA_INTEL_TOKEN_EXCHANGE_URL=
TRUSTED_MCP_CLIENTS=[]
POSTMARK_SERVER_TOKEN=
EMAIL_FROM=
EMAIL_SENDING_ENABLED=false
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_REDIRECT_URI=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
SENTRY_DSN=

# Frontend build-time settings. Analytics and cross-app links stay dormant.
VITE_KEYCLOAK_CLIENT_ID=contact-ops-app
VITE_PROJECTS_BASE_URL=
VITE_UMAMI_SRC=
VITE_UMAMI_WEBSITE_ID=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
