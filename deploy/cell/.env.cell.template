# =============================================================================
# Contact-Ops — CELL ENV CONTRACT (.env.cell.template)
# =============================================================================
# Stand up a fresh Contact-Ops cell from config. Domains are ROLES, same code:
#   PRODUCT cell  : contacts.unicorncommander.ai  (+ mcp.contacts.unicorncommander.ai,
#                   auth.unicorncommander.ai/realms/uchub = PUBLIC realm)
#   DOGFOOD cell  : contacts.magicunicorn.dev      (internal)
#   SELF-HOST cell: a customer's own host          (DEPLOYMENT_MODE=self_host)
#
# Copy to `.env`, fill every CHANGE_ME / <generate>. Anything marked
# (REQUIRED-OR-BOOT-FAILS) MUST be set or the backend refuses to start
# (see contact_ops/core/config.py model_validators). Everything in the
# DORMANT FEATURE FLAGS block is safe-OFF by default — shipping with the
# defaults gives a working, gating-free cell; you turn features on later by
# flipping flags (see README.md "Going live = flipping the dormant flags").
#
# Cross-checked field-for-field against backend/contact_ops/core/config.py.
# The LLM_* vars are read directly via os.environ in services/chat_orchestrator.py
# (NOT in Settings); they are included here because chat needs them.
# =============================================================================


# === [Core / Application] ====================================================
APP_NAME=Contact-Ops
APP_VERSION=2.7.2                       # cosmetic; surfaced at /health
ENV=prod                                # dev|test|staging|prod (prod forbids STANDALONE_MODE=true)
DEBUG=false
LOG_LEVEL=INFO                          # DEBUG|INFO|WARNING|ERROR|CRITICAL

# Deployment role. hosted = our multi-tenant SaaS (product/dogfood); tiers
# CAN be enforced. self_host = customer's own cell — entitlement/billing/quota
# gating is BYPASSED entirely (their server, their data). Set to self_host for
# the SELF-HOST variant; leave hosted for product/dogfood.
DEPLOYMENT_MODE=hosted                  # hosted | self_host

# === [Database / Redis] ======================================================
# Three DSNs, three roles, one Postgres instance:
#   contact_ops_runtime  -> app login role,    NOBYPASSRLS (RLS-subject)   -> DATABASE_URL + AUDIT_DATABASE_URL
#   contact_ops_admin    -> migration login,   BYPASSRLS   (superuser)     -> MIGRATION_DATABASE_URL
# The DB + these LOGIN roles are created by the init_db step BEFORE the stack
# boots (see README); the NOLOGIN policy roles (contact_ops_app/ro/audit) are
# CREATEd idempotently by alembic 0001 on first migrate.
#
# DATABASE_URL (REQUIRED-OR-BOOT-FAILS): async DSN, authenticates as runtime role.
DATABASE_URL=postgresql+asyncpg://contact_ops_runtime:CHANGE_ME@contact-ops-postgres:5432/contact_ops_db
# AUDIT_DATABASE_URL (optional): defaults to DATABASE_URL if unset. Same runtime role is fine.
AUDIT_DATABASE_URL=postgresql+asyncpg://contact_ops_runtime:CHANGE_ME@contact-ops-postgres:5432/contact_ops_db
# MIGRATION_DATABASE_URL (optional but STRONGLY recommended): sync DSN, BYPASSRLS
# admin role. prestart's alembic upgrade + retention sweep enumerate tenants here.
# Falls back to DATABASE_URL if unset (runtime role usually can't ALTER/CREATE).
MIGRATION_DATABASE_URL=${CONTACT_OPS_DATABASE_URL}

REDIS_URL=redis://unicorn-redis:6379/5

# Connector secret encryption (Fernet). REQUIRED-OR-BOOT-FAILS unless STANDALONE
# or ENV=test. The legacy single key remains supported. When the ordered JSON
# ring is non-empty it takes precedence: index 0 encrypts new payloads and later
# keys are decrypt-only fallbacks. Generate each key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTOR_ENCRYPTION_KEY=<generate-fernet-key>
# Rotation example (placeholders only): ["<primary-fernet-key>","<fallback-fernet-key>"]
CONNECTOR_ENCRYPTION_KEYS=

# Tenant resolution GUCs (leave as-is unless you know why).
TENANT_GUC_NAME=app.tenant_id
UC_UID_GUC_NAME=app.uc_uid
SEED_OWNER_USER_ID=00000000-0000-0000-0000-000000000001

# Boot RLS self-test probe tenants (optional, CSV-as-list). Empty = enumerate
# tenants under a privileged role; under the runtime role provide >=2 known
# tenant UUIDs so the cross-tenant isolation assertion actually runs.
RLS_SELFTEST_TENANT_IDS=

# === [Keycloak realm + switch-client] ========================================
# KEYCLOAK_ISSUER (REQUIRED-OR-BOOT-FAILS when STANDALONE_MODE=false): exact `iss`
# claim string, NO trailing /openid-connect.
#   product : https://auth.unicorncommander.ai/realms/uchub
#   dogfood : https://auth.unicorncommander.ai/realms/uchub  (shared public realm)
#   self-host: https://<their-keycloak>/realms/<their-realm>
KEYCLOAK_ISSUER=https://auth.unicorncommander.ai/realms/uchub
# Derived from issuer if blank ({issuer}/protocol/openid-connect/certs).
KEYCLOAK_JWKS_URL=
KEYCLOAK_CLIENT_ID=contact-ops-mcp
KEYCLOAK_AUDIENCE=                      # defaults to KEYCLOAK_CLIENT_ID if blank
JWKS_CACHE_TTL_SECONDS=300
JWT_ALLOWED_ALGORITHMS=["RS256"]

# azp allow-list: only these KC clients may carry a tenant_id claim. Enforce is
# warn-only (shadow) until flipped — observe real azp in logs first.
TENANT_CLAIM_ALLOWED_AZP=["contact-ops-app","contact-ops-switch","contact-ops-mcp"]
TENANT_CLAIM_AZP_ENFORCE=false

# Workspace-switch confidential client (silent re-auth). When the secret is
# EMPTY the /switch endpoint is INERT (503) — safe to deploy before the KC
# client exists. Fill after keycloak bootstrap creates contact-ops-switch.
KEYCLOAK_SWITCH_CLIENT_ID=contact-ops-switch
KEYCLOAK_SWITCH_CLIENT_SECRET=CHANGE_ME

# RFC-8693 OBO trust: upstream client IDs allowed to act on behalf of users.
TRUSTED_MCP_CLIENTS=[]

# Standalone/service mode — JWT validation bypassed, fake user. REFUSES to
# enable when ENV=prod. Leave false for any real cell.
STANDALONE_MODE=false
STANDALONE_TENANT_ID=00000000-0000-0000-0000-000000000001
STANDALONE_USER_ID=standalone-user

# CORS — set the cell's own front-end origin(s).
CORS_ORIGINS=["https://contacts.unicorncommander.ai"]
CORS_ALLOW_CREDENTIALS=true

# === [Storage: Garage / Qdrant / FalkorDB] ===================================
QDRANT_URL=http://unicorn-qdrant:6333
QDRANT_API_KEY=

FALKORDB_URL=redis://unicorn-falkordb:6379
FALKORDB_GRAPH_MODE=per_org_graph       # shared | per_org_graph | per_org_instance
FALKORDB_GRAPH_PREFIX=contact_ops__

GARAGE_ENDPOINT=http://unicorn-garage:3900
GARAGE_ADMIN_ENDPOINT=http://unicorn-garage:3903
GARAGE_ACCESS_KEY=CHANGE_ME             # placeholder sentinel disables auto-provision
GARAGE_SECRET_KEY=CHANGE_ME
GARAGE_ADMIN_TOKEN=                      # admin-API bearer; empty = auto-provision no-ops
# (GARAGE_AUTO_PROVISION / GARAGE_PROVISION_MODE live in the DORMANT block below.)

# === [Federation / Brigade] ==================================================
# Federation is domain-agnostic: the Brigade broker + RFC-8693 + per-org keys.
# A cell trusts brokers via BRIGADE_TRUSTED_ISSUER(S); each verified against its
# OWN JWKS (iss-key-mismatch guard blocks broker impersonation).
BRIGADE_REGISTRY_URL=https://brigade.unicorncommander.ai/api/registry/services
BRIGADE_SERVICE_TOKEN=                  # service registration token (optional)
BRIGADE_TRUSTED_ISSUER=https://brigade.unicorncommander.ai
# Multi-issuer trust (CSV). Set when accepting >1 broker (e.g. a customer's
# sovereign broker + the dogfood broker during migration). Empty -> singular.
BRIGADE_TRUSTED_ISSUERS=
BRIGADE_JWKS_URL=https://brigade.unicorncommander.ai/.well-known/jwks.json
BRIGADE_EXPECTED_AUDIENCE=contact-ops

# Data-Intel federation (Phase 3+; stub in Phase 0). Optional.
DATA_INTEL_BASE_URL=
DATA_INTEL_CLIENT_ID=contact-ops-publisher
DATA_INTEL_TOKEN_EXCHANGE_URL=

# Contact-import connectors (M365 / Gmail OAuth). All optional; connectors that
# lack creds are simply unavailable. Reuse suite-brokered IdP tokens where
# possible rather than minting per-app OAuth clients.
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_REDIRECT_URI=
M365_TENANT_ID=common
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=

# Front-end base (used in app-generated links).
FRONTEND_URL=https://contacts.unicorncommander.ai

# === [LLM] ===================================================================
# Read directly via os.environ in services/chat_orchestrator.py (not Settings).
# Chat raises at call-time (not boot) if base_url/api_key are blank.
LLM_BASE_URL=                           # e.g. http://midboy1:8088/v1 (OpenAI-compatible)
LLM_API_KEY=                            # any non-empty string for a local server
LLM_MODEL=gpt-4.1-mini                  # default if unset

# =============================================================================
# === DORMANT FEATURE FLAGS (flip to enable; safe defaults shown) ============
# =============================================================================
# Every flag below ships OFF. The cell runs fully without touching any of them.
# "Going live" = flipping these per the README table. Where a guard can BLOCK,
# it is shadow-first (logs would-deny, allows) so you observe before enforcing.

# --- Membership gate -------------------------------------------------------
# When true a human KC session MUST have an active user_tenant_membership or the
# request is refused. KEEP FALSE until memberships are seeded or it locks everyone out.
MEMBERSHIP_GATE_ENFORCED=false
# enable: seed memberships, then set MEMBERSHIP_GATE_ENFORCED=true

# --- Entitlement (per-tool plan-tier gate at MCP dispatch) -----------------
# false = shadow (logs entitlement_would_deny, allows). Bypassed entirely when
# DEPLOYMENT_MODE=self_host.
ENTITLEMENT_ENFORCED=false
# enable: confirm tier tags in mcp/entitlement.py, then ENTITLEMENT_ENFORCED=true (hosted only)

# --- Observability (Sentry / metrics) --------------------------------------
SENTRY_DSN=                             # empty = entire Sentry path no-ops
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0
METRICS_HTTP_ENABLED=true               # cheap + tenant-id-free; on by default
# enable Sentry: set SENTRY_DSN=<dsn> (PII never sent; send_default_pii hardcoded False)

# --- Transactional email (Postmark) ----------------------------------------
# Both must be set/true to actually send; else Noop logs email_would_send.
# Scope = app mail (invites, GDPR notices). Account verify/reset = Keycloak's job.
POSTMARK_SERVER_TOKEN=                  # reuse the suite's ONE shared Postmark token
EMAIL_FROM=REMOVED   # MUST be a confirmed Postmark Sender Signature
EMAIL_SENDING_ENABLED=false
EMAIL_MESSAGE_STREAM=outbound
EMAIL_INVITES_ALLOW_PENDING=false       # true once pending-invitations table lands
# enable: set POSTMARK_SERVER_TOKEN + confirm EMAIL_FROM signature + EMAIL_SENDING_ENABLED=true

# --- Storage auto-provision (per-tenant Garage buckets) --------------------
GARAGE_AUTO_PROVISION=false             # no-ops if self_host, no admin token, or placeholder access key
GARAGE_PROVISION_MODE=shared_key        # shared_key (v1) | per_tenant_key (future, needs 0042 column)
# enable: set GARAGE_ADMIN_TOKEN + real GARAGE_ACCESS_KEY, GARAGE_AUTO_PROVISION=true, run _bootstrap_cli

# --- Internet-exposure hardening (4 independent guards, all shadow-first) ---
# response headers
SECURITY_HEADERS_ENABLED=false
SECURITY_HEADERS_SHADOW_MODE=true       # log would-set, attach nothing
SECURITY_HSTS_ENABLED=false             # never pin HTTPS in dev/self-host over http
CONTENT_SECURITY_POLICY=default-src 'none'; frame-ancestors 'none'
# enable: SECURITY_HEADERS_ENABLED=true (+ SECURITY_HEADERS_SHADOW_MODE=false to actually attach; HSTS only behind TLS)
# request body size cap
BODY_SIZE_LIMIT_ENABLED=false
BODY_SIZE_SHADOW_MODE=true              # log would-413, allow through
MAX_REQUEST_BODY_BYTES=10485760         # 10 MiB
BODY_SIZE_PATH_OVERRIDES={}             # {"/path/prefix": larger_cap} e.g. bulk import
# enable: BODY_SIZE_LIMIT_ENABLED=true then BODY_SIZE_SHADOW_MODE=false
# rate limiting (Redis-backed)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_SHADOW=true                  # log would-block, allow
RATE_LIMIT_DEFAULT=120/minute
TRUSTED_PROXY_IPS=[]                    # Traefik IP/CIDR; only then trust X-Forwarded-For
# enable: set TRUSTED_PROXY_IPS, RATE_LIMIT_ENABLED=true, then RATE_LIMIT_SHADOW=false
# SSRF egress guard
SSRF_GUARD_ENABLED=false
SSRF_SHADOW=true                        # log ssrf_would_block, allow — observe internal targets first
SSRF_HTTPS_ONLY=false                   # suite uses http:// internal URLs
SSRF_ALLOW_PRIVATE_NETWORKS=false       # block private once enabled; allowlist re-permits
SSRF_ALLOWED_HOSTS=[]                   # suite-internal hosts that bypass IP check (federation/CardDAV)
# enable: populate SSRF_ALLOWED_HOSTS, SSRF_GUARD_ENABLED=true, then SSRF_SHADOW=false

# --- Billing / metering (suite Lago) ----------------------------------------
BILLING_PROVIDER=manual                 # manual (Noop) | lago | federated
LAGO_API_URL=                           # e.g. http://unicorn-lago-api:3000
LAGO_API_KEY=                           # empty = Lago leg inert
BILLING_QUOTA_ENFORCED=false            # shadow (logs quota_would_deny) until true; self_host bypasses
# enable: BILLING_PROVIDER=lago + LAGO_API_URL + LAGO_API_KEY, then BILLING_QUOTA_ENFORCED=true (hosted only)

# --- GDPR compliance engine -------------------------------------------------
COMPLIANCE_ENGINE_ENABLED=false         # false = immediate glass-break erase; true = two-phase tombstone+grace
ERASURE_GRACE_DAYS=30                   # real undo window once engine enabled
EXPORT_SIGNED_URL_TTL_SECONDS=900       # Garage export link lifetime
# enable: COMPLIANCE_ENGINE_ENABLED=true (turns the returned undo window REAL)

# --- GDPR retention sweep (daily Celery beat) -------------------------------
RETENTION_SWEEP_ENABLED=false           # top-level gate; false = task touches nothing
RETENTION_SWEEP_SHADOW=true             # even when enabled, shadow only LOGS retention_would_purge
RETENTION_EPHEMERAL_TTL_DAYS=30
RETENTION_OPERATIONAL_TTL_DAYS=730
RETENTION_SWEEP_BATCH_LIMIT=500         # persons purged per tenant per tick
# enable: RETENTION_SWEEP_ENABLED=true (observe logs), then RETENTION_SWEEP_SHADOW=false to hard-purge

# --- Public self-serve signup -----------------------------------------------
# Backend-driven: SPA fetches /api/auth/signup-config, so flipping signup is a
# backend env change (NO frontend rebuild).
SIGNUP_ENABLED=false
SIGNUP_MODE=suite                       # suite (link to SUITE_SIGNUP_URL) | standalone (CO's own KC registration)
SUITE_SIGNUP_URL=                       # product cell signup, e.g. https://unicorncommander.ai/signup
# enable: SIGNUP_ENABLED=true (+ SUITE_SIGNUP_URL for suite mode, or enable realm self-registration for standalone)

# =============================================================================
# === FRONTEND BUILD VARS (VITE_*) — BAKE AT BUILD TIME, NOT RUNTIME =========
# =============================================================================
# These are NOT read by the backend. They are compiled into the SPA bundle by
# `vite build` in frontend/Dockerfile.prod. Changing analytics keys requires a
# FRONTEND REBUILD + redeploy, not just an env flip. (Signup is the exception —
# it is backend-driven and needs no rebuild.) For self-host, leave the analytics
# VITE_UMAMI_*/VITE_POSTHOG_* UNSET so the cell does not phone home.
VITE_MCP_BASE_URL=https://mcp.contacts.unicorncommander.ai
VITE_KEYCLOAK_ISSUER=https://auth.unicorncommander.ai/realms/uchub
VITE_KEYCLOAK_CLIENT_ID=contact-ops-app
VITE_UMAMI_SRC=                         # analytics; leave empty = no phone-home
VITE_UMAMI_WEBSITE_ID=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
