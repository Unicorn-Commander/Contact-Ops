# Copy to ~/.config/contact-ops/backup.env and chmod 600.
# Never commit the populated file. Prefer a named AWS profile or instance
# identity; exported keys are shown only for S3-compatible providers that do not
# support either option.

CONTACT_OPS_BACKUP_REMOTE_URI=s3://replace-with-bucket/contact-ops-backups
# S3-compatible providers only; leave unset for AWS itself.
# CONTACT_OPS_BACKUP_S3_ENDPOINT=https://replace-with-provider-endpoint

# Restore auto-discovers the backend, Celery worker, and beat by Compose labels.
# Override only for a nonstandard topology; names are whitespace-separated.
# CONTACT_OPS_WRITER_CONTAINERS="contact-ops-backend contact-ops-celery-worker contact-ops-celery-beat"
# CONTACT_OPS_COMPOSE_PROJECT=contact-ops

# Choose one standard AWS credential-chain method:
# export AWS_PROFILE=contact-ops-backup
# export AWS_ACCESS_KEY_ID=replace-at-deploy
# export AWS_SECRET_ACCESS_KEY=replace-at-deploy
# export AWS_DEFAULT_REGION=replace-at-deploy
